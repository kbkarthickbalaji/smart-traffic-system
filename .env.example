# Smart Traffic API — Environment Configuration
# Copy this to .env and customize values

# ── JWT Security ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=SmartTraffic-Secure-Secret-Key-2026-MinimumLength32Characters!

# Token expiry (minutes)
TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost,https://localhost

# ── App Mode ──────────────────────────────────────────────────────────────────
# Set to "true" to enable /docs, /redoc, /openapi.json
DEBUG=false
ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────────────────────────
# Absolute path to SQLite database file
DB_PATH=traffic.db
